# Domain Caddy serves (HTTPS via automatic Let's Encrypt cert).
TITO_DOMAIN=185-147-159-26.sslip.io

# Git branch/tag of https://github.com/Forzalab/open-webui to deploy.
TITO_REF=tito

# OWUI image tag. pin to tito-<sha> for LTS.
TITO_IMAGE_TAG=tito

# REQUIRED. Neon today; after cutover (db/cutover.md) the local Postgres:
#   DATABASE_URL=postgresql://tito:<POSTGRES_PASSWORD value>@postgres:5432/tito
# (plain postgresql:// is fine: OWUI maps it to psycopg2/psycopg itself; no sslmode on the docker network)
DATABASE_URL=

# Local Postgres password. Auto-generated by bootstrap.sh if missing/empty. Hex, URL-safe.
POSTGRES_PASSWORD=

# TEMPORARY: old Neon connection string, the cutover source (db/cutover.md). Remove after Neon is deleted.
NEON_DATABASE_URL=

# REQUIRED (auto-generated by bootstrap.sh if empty)
WEBUI_SECRET_KEY=

# REQUIRED (Google OAuth is the only sign-in method)
GOOGLE_CLIENT_ID=

# REQUIRED
GOOGLE_CLIENT_SECRET=

# REQUIRED
ANTHROPIC_API_KEY=

# Optional: Discord webhook for Tito alerts.
TITO_DISCORD_WEBHOOK=
# Urgent channel for ping_tony (@mentions Tùng). Empty = use TITO_DISCORD_WEBHOOK.
TITO_URGENT_WEBHOOK=

# Google Places API (New) key for the places tool. Restrict to Places API + box IP.
TITO_PLACES_API_KEY=

# calendar-mcp proxy image tag. TODO verify flavor (npx needs -debian-node) at deploy.
MCP_PROXY_TAG=v0.12.0-debian-node

# calendar-mcp stdio server command (placeholder). TODO verify.
CALENDAR_MCP_CMD=npx -y workspace-lite

# calendar-mcp Google Apps Script config (passed to the stdio server).
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=
